<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_gradient_banner"
                android:paddingTop="36dp"
                android:paddingBottom="56dp"
                android:paddingHorizontal="24dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/badge_white">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic_glyph"
                        app:tint="@color/brand_end" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:alpha="0.9" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="-36dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <TextView
                        android:id="@+id/tvRiskTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- HOME -->
                    <LinearLayout
                        android:id="@+id/stateHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:id="@+id/btnMic"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:background="@drawable/bg_mic_circle"
                            android:elevation="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mic_glyph" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/home_tap"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="@string/home_hint"
                            android:textSize="15sp"
                            android:textColor="@color/muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/home_example_1"
                            android:textSize="17sp"
                            android:textStyle="italic"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_example_2"
                            android:textSize="17sp"
                            android:textStyle="italic"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_example_3"
                            android:textSize="17sp"
                            android:textStyle="italic"
                            android:textColor="@color/ink" />
                    </LinearLayout>

                    <!-- LISTENING -->
                    <LinearLayout
                        android:id="@+id/stateListening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/bg_mic_circle">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mic_glyph" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvListeningStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/listening"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />
                    </LinearLayout>

                    <!-- PERMISSION -->
                    <LinearLayout
                        android:id="@+id/statePermission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPermissionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/permission_needed"
                            android:textSize="19sp"
                            android:textColor="@color/ink" />

                        <Button
                            android:id="@+id/btnGrantPermission"
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_primary_btn"
                            android:text="Cấp quyền micro"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- AUTO (low risk, no confirmation) -->
                    <LinearLayout
                        android:id="@+id/stateAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/badge_good"
                            android:gravity="center"
                            android:text="✓"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvAutoText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/no_confirmation_needed"
                            android:textSize="15sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>

                    <!-- CONFIRM (medium/high risk) -->
                    <LinearLayout
                        android:id="@+id/stateConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvConfirmText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"
                            android:lineSpacingExtra="4dp" />

                        <Button
                            android:id="@+id/btnConfirmYes"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_confirm_btn"
                            android:text="@string/confirm_yes"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnConfirmNo"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_cancel_btn"
                            android:text="@string/confirm_no"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- EXECUTING -->
                    <LinearLayout
                        android:id="@+id/stateExecuting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:indeterminateTint="@color/brand_solid" />

                        <TextView
                            android:id="@+id/tvExecutingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />
                    </LinearLayout>

                    <!-- DONE -->
                    <LinearLayout
                        android:id="@+id/stateDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/badge_good"
                            android:gravity="center"
                            android:text="✓"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvDoneText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />

                        <Button
                            android:id="@+id/btnDoneHome"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_primary_btn"
                            android:text="@string/back_home"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- CANCELLED -->
                    <LinearLayout
                        android:id="@+id/stateCancelled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/badge_neutral"
                            android:gravity="center"
                            android:text="↩"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/cancelled_title"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />

                        <Button
                            android:id="@+id/btnCancelledHome"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_primary_btn"
                            android:text="@string/back_home"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- CLARIFY -->
                    <LinearLayout
                        android:id="@+id/stateClarify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/badge_neutral"
                            android:gravity="center"
                            android:text="?"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvClarifyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink"
                            android:lineSpacingExtra="4dp" />

                        <Button
                            android:id="@+id/btnClarifyRetry"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_marginTop="26dp"
                            android:background="@drawable/bg_primary_btn"
                            android:text="@string/try_again"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- NOT UNDERSTOOD -->
                    <LinearLayout
                        android:id="@+id/stateNotUnderstood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/badge_neutral"
                            android:gravity="center"
                            android:text="?"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/not_understood_title"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/not_understood_body"
                            android:textSize="15sp"
                            android:textColor="@color/muted" />

                        <Button
                            android:id="@+id/btnNotUnderstoodRetry"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="22dp"
                            android:background="@drawable/bg_primary_btn"
                            android:text="@string/try_again"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

